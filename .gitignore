# Track workspace source, documentation, and reusable project assets.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements-pen.txt
!/scripts/
!/docs/
!/assets/
!/src/

# Working drawing runs stay local; snapshots are in assets/archives/.
/assets/outputs/
**/.preview_cache/

# Preserve nested repositories locally; never commit their Git metadata.
/src/**/.git

# Generated builds, fetched dependencies, and caches anywhere under src.
**/build/
**/install/
**/log/
**/.cache/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/node_modules/
**/.venv/
**/.venv-*/
/src/flexiv_rdk/thirdparty/cloned/

# Bundled browser runtime is a dependency, not a local build product.
!/src/pen_bringup/web/vendor/three/build/
!/src/pen_bringup/web/vendor/three/build/**

# Local firmware configuration and machine/secret files.
/src/pen_servo/firmware/pen_servo_esp32/sdkconfig
/src/pen_servo/firmware/pen_servo_esp32/sdkconfig.old
**/.env
**/.env.local
**/.env.*.local
**/*.pem
**/*.key
**/.DS_Store
