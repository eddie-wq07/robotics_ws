<?xml version="1.0"?>
<package format="3">
  <name>flexiv_cartesian_controller</name><version>0.1.0</version>
  <description>Direct SDK Cartesian pose interface for the Flexiv ros2_control hardware.</description>
  <maintainer email="engineering@industrialnext.ai">Industrial Next</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend><depend>controller_manager_msgs</depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend><depend>rclcpp</depend>
  <depend>realtime_tools</depend><depend>geometry_msgs</depend><depend>diagnostic_msgs</depend>
