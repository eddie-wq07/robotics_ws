CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
# Supervised bench settings only; not qualified for drawing or unattended use.
CONFIG_PEN_CALIBRATED=y
CONFIG_PEN_PWM_HZ=50
CONFIG_PEN_RELEASE_DEG=110
CONFIG_PEN_PRESS_DEG=140
CONFIG_PEN_PWM_MIN_US=500
CONFIG_PEN_PWM_MAX_US=2400
CONFIG_PEN_DEBOUNCE_MS=10
CONFIG_PEN_MAX_PRESS_MS=600000
